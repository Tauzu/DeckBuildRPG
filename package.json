{
  "name": "deckbuild-rpg",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @deckbuild/client",
    "build": "npm run build -w @deckbuild/client",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "sim": "npm run sim -w @deckbuild/sim --",
    "dev:server": "npm run dev -w @deckbuild/server",
    "start": "npm run build && npm run start -w @deckbuild/server",
    "dev:lan": "npm run dev:lan -w @deckbuild/client"
  }
}
